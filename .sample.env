# Copy to `.env` and fill in. Values with special characters can be quoted, e.g. KEY="value".

# --- Databases ---
# PostgreSQL for Sofia's data (users, assignments, assessments, scheduled tasks, tool call history, stickers)
SQL_DATABASE_URL=postgres://user:password@localhost:5432/sofia
# PostgreSQL for the WhatsApp session and message store (baileys-bottle)
BAILEYS_BOTTLE_SQL_DATABASE_URL=postgres://user:password@localhost:5432/sofia_whatsapp
# Milvus vector database for memories and sticker search (default: localhost:19530)
MILVUS_ADDRESS=localhost:19530

# --- Alibaba Model Studio ---
# DashScope API key, used for chat, embeddings (text-embedding-v4), vision and the decision model
ALIBABA_API_KEY=
# Your workspace's OpenAI compatible URL. Needed for the decision model (group chat replies).
# Falls back to https://dashscope.aliyuncs.com/compatible-mode/v1 if unset.
MODELSTUDIO_WORKSPACE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Chat model, it also reads images and describes stickers (default: qwen3.8-flash)
CHAT_MODEL=qwen3.8-flash
# Image generation/editing models (generate_image, edit_image): standard and "pro" (better text and detail)
IMAGE_MODEL=qwen-image-3.0
IMAGE_MODEL_PRO=qwen-image-3.0-pro
# Sticker Processing Model, it describes stickers and gifs. Falls back to CHAT_MODEL on Model Studio, qwen3.8-flash otherwise
STICKER_PROCESSING_MODEL=qwen3.8-flash

# --- Chat provider (optional) ---
# Chat with another OpenAI compatible provider (Responses API) instead of Model Studio, e.g. DeepSeek:
#   CHAT_BASE_URL=https://api.deepseek.com
#   CHAT_API_KEY=<DeepSeek API key>
#   CHAT_MODEL=deepseek-flash
# Both fall back to Model Studio (MODELSTUDIO_WORKSPACE_URL, ALIBABA_API_KEY) if unset. Embeddings, the decision model
# and sticker descriptions always use Model Studio.
CHAT_BASE_URL=
CHAT_API_KEY=

# Lets Sofia search the web and read web pages, "true" or "false" (default: false). On Model Studio these are its
# built-in web_search and web_extractor tools (a news question took 46k-111k input tokens against ~5k for a normal
# reply). On DeepSeek (CHAT_BASE_URL=https://api.deepseek.com) they use DeepSeek's Search & Fetch APIs instead
# ($0.75 per 1,000 requests each).
USE_WEB_TOOLS=false

# --- Google Workspace (GDGoC) ---
# Sofia's own account (sofia@nyp-gdg.com) for Drive, Docs, Sheets, Slides and the directory, see README.
# Sign in with `pnpm google-auth`; the Workspace tools are only added once the token exists.
WORKSPACE_CLIENT_SECRET_PATH=./assets/workspace_client_secret.json
WORKSPACE_TOKEN_PATH=./assets/google-workspace-token.json
# The club's shared drive, where new files go (`pnpm google-auth --check` lists the ids)
GDG_SHARED_DRIVE_ID=
# Model for image search (Model Studio's web_search_image, which DeepSeek models don't support)
IMAGE_SEARCH_MODEL=qwen3.8-flash

# --- Google Calendar (timetable) ---
# The calendar(s) to read the timetable from, comma separated. OAuth files go in assets/ (client_secret.json, token.json).
# With several calendars (e.g. one per specialisation track), each is its own section of the timetable, titled with
# the calendar's name, in the order listed here, with its classes in time order.
GOOGLE_CAL_ID=
# Optional: comma separated module codes to leave out of the timetable (the first word of an event's description)
IGNORED_MODULES=

# --- Web UI ---
# Password for the web UI (stickers, GIFs and users, any username). The UI is disabled unless this is set.
WEBUI_PASSWORD=
# Port and host it listens on (default: 3000 on 127.0.0.1). Keep it on localhost and use SSH port forwarding.
WEBUI_PORT=3000
WEBUI_HOST=127.0.0.1

# --- Media ---
# Let Sofia view videos (only the first frame, but the whole file is downloaded). Off unless "true". GIFs always work.
ENABLE_VIDEO=false

# --- Other ---
# Log level for log.log: trace, debug, info, warn, error (default: info)
LOG_LEVEL=info
# "true" stops Sofia replying to WhatsApp messages and blocks memory writes and scheduled task changes. Used while testing.
TESTING=false
